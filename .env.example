# Copy to .env and fill in. Never commit the real .env.

# Required in production: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# False in production
DJANGO_DEBUG=False

# Comma-separated host names this site answers on
DJANGO_ALLOWED_HOSTS=qr.reluxelectric.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://qr.reluxelectric.com

# Public base URL encoded into every printed QR code (no trailing slash).
# QR codes point to  <QR_BASE_URL>/q/<token>/  – choose this BEFORE printing stickers.
QR_BASE_URL=https://qr.reluxelectric.com

# Optional
# SQLITE_PATH=/home/site/data/db.sqlite3
# TIME_ZONE=Asia/Kolkata
# DJANGO_SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_AGE=28800
# LOG_LEVEL=INFO
